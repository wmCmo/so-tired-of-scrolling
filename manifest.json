{
  "manifest_version": 3,
  "name": "I'm so tired of scrolling",
  "short_name": "So tired",
  "version": "1.3.0",
  "description": "Stop the endless scroll on YouTube Shorts and Instagram Reels. A pause, a daily count, and one video if you really mean it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["ig.js"],
      "css": ["ig-hide.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"]
    }
  ]
}
